# Local dev
NODE_ENV=development

# API URL (backend)
API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Auth.js — 32+ random chars; the API shares this secret
AUTH_SECRET=change-me-to-random-32-char-string
AUTH_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Only emails on these domains can sign in as staff
ALLOWED_EMAIL_DOMAINS=alpagomanufacturing.com

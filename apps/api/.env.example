# ===== CORE =====
ENV=local
LOG_LEVEL=INFO

# ===== DATABASE =====
# LOCAL DEV (default): file-based SQLite — zero install, works out of the box.
DATABASE_URL=sqlite+aiosqlite:///./alpago_dev.db
#
# RENDER / PRODUCTION: Postgres (automatically injected from the managed DB).
#   DATABASE_URL=postgresql+psycopg://user:pass@host:5432/alpago_hr

# ===== REDIS / CELERY =====
# LOCAL DEV: leave empty. Celery runs in eager mode (jobs execute inline, no broker needed).
REDIS_URL=
#
# RENDER / PRODUCTION:
#   REDIS_URL=redis://default:pass@host:6379/0

# ===== AUTH =====
# Shared with the frontend's AUTH_SECRET. 32+ random chars.
AUTH_SECRET=change-me-to-random-32-char-string

# ===== GOOGLE OAUTH (staff SSO) =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_EMAIL_DOMAINS=alpagomanufacturing.com

# ===== AI (CLAUDE) =====
ANTHROPIC_API_KEY=sk-ant-...
AI_MODEL_STANDARD=claude-sonnet-5-5
AI_MODEL_FAST=claude-haiku-5-5

# ===== EMAIL (RESEND) — optional in dev =====
RESEND_API_KEY=
EMAIL_FROM="Alpago HR <hr@alpagomanufacturing.com>"

# ===== WHATSAPP — optional in dev =====
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ===== STORAGE (CLOUDFLARE R2) — optional in dev =====
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=alpago-hr-local
R2_ENDPOINT=

# ===== OBSERVABILITY =====
SENTRY_DSN=
